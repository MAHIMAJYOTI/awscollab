# Set to false to use real AWS DynamoDB (requires credentials below or `aws configure`)
USE_LOCAL_STORE=true

# AWS Configuration — required when USE_LOCAL_STORE=false
# Get keys: AWS Console → IAM → Users → Your user → Security credentials → Create access key
# IAM permissions needed: AmazonDynamoDBFullAccess (or scoped DynamoDB policy)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
# Application Configuration
PORT=5000
NODE_ENV=development

# DynamoDB Table Names (optional - defaults are set in config)
CHAT_ROOMS_TABLE=ChatRooms
MESSAGES_TABLE=Messages
MEETINGS_TABLE=Meetings
PROJECTS_TABLE=Projects
PROJECT_FILES_TABLE=ProjectFiles

# JDoodle Code Execution (https://www.jdoodle.com/compiler-api/)
# Free tier: ~200 credits/day. Without these, Node.js/Python still run locally when USE_LOCAL_STORE=true.
JDOODLE_CLIENT_ID=your_jdoodle_client_id
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret

# Frontend URL for password reset links
FRONTEND_URL=http://localhost:3000
